#[import(cc = "device", name = "rsqrt")]             fn vulkan_rsqrt(f64) -> f64;
#[import(cc = "device", name = "sqrt")]              fn vulkan_sqrt(f64) -> f64;
#[import(cc = "device", name = "fabs")]              fn vulkan_fabs(f64) -> f64;
