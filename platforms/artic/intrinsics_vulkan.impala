#[import(cc = "device", name = "isinf")]             fn vulkan_isinf(f64) -> i32;
#[import(cc = "device", name = "isnan")]             fn vulkan_isnan(f64) -> i32;
#[import(cc = "device", name = "isfinite")]          fn vulkan_isfinite(f64) -> i32;
